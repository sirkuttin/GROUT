<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>GROUT</AssemblyName><RootNamespace>ReleaseDock</RootNamespace><Product>GROUT</Product><Title>G.R.O.U.T.</Title><Description>Git Release Observer &amp; Update Tool</Description><OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <LangVersion>latest</LangVersion>
    <DebugType>none</DebugType>
    <PlatformTarget>x64</PlatformTarget>
    <AutoGenerateBindingRedirects>false</AutoGenerateBindingRedirects>
    <GenerateSupportedRuntime>false</GenerateSupportedRuntime>
    <NexusTestingEnabled Condition="'$(NexusTestingEnabled)' == ''">false</NexusTestingEnabled>
    <DefineConstants Condition="'$(NexusTestingEnabled)' == 'true'">$(DefineConstants);NEXUS_TESTING</DefineConstants>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <Version>0.9.0</Version>
    <ApplicationIcon>Assets/GROUT.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Reference Include="System.Web" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="Microsoft.CSharp" />
    <Reference Include="Microsoft.VisualBasic" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
  <ItemGroup>
    <Resource Include="Assets/GROUT.ico" />
    <EmbeddedResource Include="../LICENSE" Link="Licenses/GROUT-LICENSE.txt" />
    <EmbeddedResource Include="../licenses/*.txt" Link="Licenses/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
