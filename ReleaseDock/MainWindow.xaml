<Window x:Class="ReleaseDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="G.R.O.U.T." Width="1120" Height="800" MinWidth="940" MinHeight="650" Background="#0C1422" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="32">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,28">
   <WrapPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><Button x:Name="CheckButton" Content="Check now" Click="Check_Click"/><Button x:Name="AddAppButton" Content="+ Add App" Click="Add_Click" Background="#267E70"/></WrapPanel>
   <StackPanel><TextBlock Text="G.R.O.U.T." Foreground="#76DCC6" FontSize="12" FontWeight="SemiBold"/><TextBlock Text="Your apps, kept together." FontSize="28" FontWeight="SemiBold" Margin="0,8,0,6"/><TextBlock x:Name="CountLabel" Text="Track releases. Update on your terms." Foreground="#A4B4C9"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <ListBox x:Name="Library" Background="#101C2D" BorderThickness="0" Foreground="White" HorizontalContentAlignment="Stretch" SelectionChanged="Selected">
    <ListBox.ItemTemplate><DataTemplate><StackPanel Margin="10,14"><TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding ProjectLabel}" Foreground="#A4B4C9" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectLabel}"/><TextBlock Text="{Binding DisplayStatus}" Foreground="{Binding StatusColor}" Margin="0,6,0,0" TextWrapping="Wrap"/></StackPanel></DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border Grid.Column="2" Background="#142033" CornerRadius="12" Padding="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="AppTitle" Text="Bring your apps aboard." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock x:Name="SourceLabel" Foreground="#A4B4C9" Margin="0,6,0,0" TextWrapping="Wrap"/><TextBlock x:Name="VersionLabel" Text="Choose Add App to track an existing installation or install something new from a supported release host." Foreground="#A4B4C9" Margin="0,12,0,16" TextWrapping="Wrap"/>
     <StackPanel x:Name="Details" Visibility="Collapsed">
      <TextBlock x:Name="StateLabel" Foreground="#76DCC6" FontSize="18" Margin="0,0,0,16"/>
      <Border x:Name="MissingBanner" Visibility="Collapsed" Background="#352D20" BorderBrush="#F0D495" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="App not found" Foreground="#F0D495" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="MissingMessage" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="FindInstallationButton" Content="Find installation…" Click="FindInstallation_Click" Background="#267E70"/><Button Content="Stop tracking" Click="Remove_Click"/></WrapPanel></StackPanel></Border><WrapPanel><Button x:Name="UpdateButton" Content="Update" Background="#267E70" Click="Update_Click" ToolTipService.ShowOnDisabled="True"/><Button Content="Release notes ↗" Click="Release_Click"/><Button x:Name="AppSettingsButton" Content="App settings" Click="AppSettings_Click"/></WrapPanel>
      <TextBlock x:Name="MethodLabel" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,14,0,8"/>
      <TextBlock x:Name="UpdateStateLabel" TextWrapping="Wrap" Foreground="#F0D495" Margin="0,0,0,10"/>
      <WrapPanel Margin="0,0,0,12"><Button x:Name="AppFolderButton" Content="Open app folder" Click="AppFolder_Click"/><Button x:Name="DownloadedButton" Content="Open downloaded package folder" Click="Downloaded_Click"/></WrapPanel>
      <Expander x:Name="VersionSection" Header="Installed version" Foreground="#F1F5FC" Margin="0,10,0,12">
       <StackPanel Margin="0,12,0,0">
        <TextBlock x:Name="LocalLabel" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel><Button Content="Recheck version" Click="Recheck_Click"/><Button Content="Mark latest as installed" Click="Mark_Click"/></WrapPanel>
        <TextBlock Text="Or enter the installed release tag manually:" Foreground="#A4B4C9" Margin="0,12,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstalledInput" AutomationProperties.Name="Installed version"/><Button Grid.Column="1" Content="Save" Click="SaveVersion_Click" Margin="8,0,0,0"/></Grid>
        <TextBlock Text="Manual marking pauses automatic detection. Resume it in App settings." Foreground="#A4B4C9" Margin="0,10,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Expander>
      <Expander Header="Release notes" Foreground="#F1F5FC" Margin="0,0,0,12"><TextBlock x:Name="Notes" TextWrapping="Wrap" Margin="0,12,0,0"/></Expander>
      <TextBlock x:Name="CheckedLabel" Foreground="#A4B4C9" Margin="0,10,0,12"/>
      <WrapPanel><Button x:Name="RecoveryButton" Content="Restore previous files…" Click="Recovery_Click"/><Button x:Name="UninstallButton" Content="Uninstall…" Click="Uninstall_Click"/><Button x:Name="RemoveButton" Content="Stop tracking" Click="Remove_Click" Background="Transparent" Foreground="#F3A6AA"/></WrapPanel>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,20,0,0"><WrapPanel Margin="0,0,0,10"><TextBlock x:Name="SelfUpdateLabel" VerticalAlignment="Center" Foreground="#A4B4C9" Margin="0,0,12,0"/><Button x:Name="CheckSelfButton" Content="Check GROUT updates" Click="CheckSelf_Click"/><Button x:Name="InstallSelfButton" Content="Update and restart" Click="InstallSelf_Click" Visibility="Collapsed" Background="#267E70"/></WrapPanel><ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,10"/><Button x:Name="CancelDownload" Content="Cancel download" Click="Cancel_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,10"/>
   <DockPanel><Button x:Name="SettingsButton" DockPanel.Dock="Right" Content="Settings" Click="Settings_Click"/><StackPanel><TextBlock x:Name="ScheduleLabel" Foreground="#A4B4C9" TextWrapping="Wrap"/><TextBlock x:Name="StatusLabel" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,6,12,0"/></StackPanel></DockPanel>
  </StackPanel>
 </Grid>
</Window>
