<Window x:Class="ReleaseDock.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="G.R.O.U.T." Icon="Assets/GROUT.ico" Width="1120" Height="800" MinWidth="940" MinHeight="650" Background="#0C1422" FontFamily="Segoe UI" FontSize="14" WindowStartupLocation="CenterScreen">
 <Grid Margin="16">
  <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <DockPanel Margin="0,0,0,16">
   <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Margin="16,0,0,0"><WrapPanel><Button x:Name="CheckButton" Content="Check now" Click="Check_Click"/><Button x:Name="AddAppButton" Content="+ Add App" Click="Add_Click" Background="#267E70"/></WrapPanel><TextBlock x:Name="CountLabel" Text="Track releases. Update on your terms." Foreground="#A4B4C9" Margin="0,8,0,0"/></StackPanel>
   <StackPanel><TextBlock x:Name="LibraryHeading" Text="Library" FontSize="28" FontWeight="SemiBold"/><TextBlock Text="Organize your apps, mods and updates" Foreground="#A4B4C9" Margin="0,6,0,0"/></StackPanel>
  </DockPanel>
  <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="330"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <StackPanel Grid.ColumnSpan="3" Margin="0,0,0,12">
    <WrapPanel x:Name="LibraryFilters" Margin="0"><TextBlock x:Name="SearchLabel" Text="Search library" VerticalAlignment="Center" Margin="0,0,8,0"/><TextBox x:Name="LibrarySearch" Width="200" TextChanged="Search_Changed" AutomationProperties.Name="Search library"/><CheckBox x:Name="UpdatesOnlyFilter" Content="Updates only" Foreground="#F1F5FC" VerticalAlignment="Center" Margin="16,0,0,0" Click="UpdatesOnly_Click"/></WrapPanel>
   </StackPanel>

   <ListBox Grid.Row="1" x:Name="Library" Background="#101C2D" BorderThickness="0" Foreground="White" HorizontalContentAlignment="Stretch" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="Selected" ContextMenuOpening="TreeMenu_Opening" PreviewMouseRightButtonDown="TreeRightClick" AllowDrop="True" PreviewMouseLeftButtonDown="TreeMouseDown" PreviewMouseMove="TreeMouseMove" DragOver="TreeDragOver" Drop="TreeDrop" DragLeave="TreeDragLeave">
    <ListBox.ContextMenu><ContextMenu/></ListBox.ContextMenu><ListBox.ItemTemplate><DataTemplate>
     <Grid Margin="{Binding TreeMargin}">
      <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <Button Content="{Binding TreeGlyph}" Tag="{Binding}" IsEnabled="{Binding HasChildren}" Click="ExpandNode_Click" Width="18" Padding="0" Background="Transparent" Margin="0,0,4,0" VerticalAlignment="Top"/>
      <StackPanel Grid.Column="1" Margin="0,0,12,0">
       <TextBlock Text="{Binding AppName}" FontSize="16" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip="{Binding AppName}"/>
       <TextBlock Text="{Binding InstallationSummary}" ToolTip="{Binding InstallationSummary}" Foreground="#76DCC6" FontSize="12" TextTrimming="CharacterEllipsis"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock><TextBlock Text="{Binding ProjectLabel}" Foreground="#A4B4C9" FontSize="12" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" ToolTip="{Binding ProjectLabel}"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      </StackPanel>
      <TextBlock Grid.Column="2" Text="{Binding LibraryStatus}" ToolTip="{Binding LibraryStatusHint}" Foreground="{Binding LibraryStatusColor}" MaxWidth="110" TextAlignment="Right" HorizontalAlignment="Right" VerticalAlignment="Center" TextWrapping="Wrap"/>
     </Grid>
    </DataTemplate></ListBox.ItemTemplate>
   </ListBox>
   <Border x:Name="DetailsPanel" Grid.Row="1" Grid.Column="2" Background="#142033" CornerRadius="12" Padding="24">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel>
     <TextBlock x:Name="AppTitle" Text="Bring your apps aboard." FontSize="26" FontWeight="SemiBold" TextWrapping="Wrap"/>
     <TextBlock Foreground="#A4B4C9" Margin="0,6,0,0" TextWrapping="Wrap"><Hyperlink x:Name="RepositoryLink" Foreground="#76DCC6" Click="Repository_Click"><Run x:Name="SourceLabel"/></Hyperlink></TextBlock><TextBlock x:Name="TargetContextLabel" Foreground="#76DCC6" TextWrapping="Wrap" Margin="0,10,0,0"/><TextBlock x:Name="VersionLabel" Text="Choose Add App to track an existing installation or install something new from a supported release host." Foreground="#A4B4C9" Margin="0,12,0,16" TextWrapping="Wrap"/>
     <StackPanel x:Name="GroupDetails" Visibility="Collapsed"><TextBlock x:Name="GroupDescription" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,12,0,16"/><WrapPanel><Button Content="Add child…" Click="AddChild_Click"/><Button Content="Edit group…" Click="Organize_Click"/><Button Content="Remove group" Click="Remove_Click"/></WrapPanel></StackPanel>
     <StackPanel x:Name="Details" Visibility="Collapsed">
      <TextBlock x:Name="StateLabel" Foreground="#76DCC6" FontSize="18" Margin="0,0,0,16"/>
      <Border x:Name="MissingBanner" Visibility="Collapsed" Background="#352D20" BorderBrush="#F0D495" BorderThickness="1" CornerRadius="6" Padding="16" Margin="0,0,0,18"><StackPanel><TextBlock Text="App not found" Foreground="#F0D495" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="MissingMessage" TextWrapping="Wrap" Margin="0,8,0,12"/><WrapPanel><Button x:Name="FindInstallationButton" Content="Find installation…" Click="FindInstallation_Click" Background="#267E70"/><Button Content="Stop tracking" Click="Remove_Click"/></WrapPanel></StackPanel></Border><WrapPanel><Button x:Name="UpdateButton" Content="Update" Background="#267E70" Click="Update_Click" ToolTipService.ShowOnDisabled="True"/><Button Content="Release notes ↗" Click="Release_Click"/><Button x:Name="AppSettingsButton" Content="Settings" Click="AppSettings_Click"/></WrapPanel>
      <TextBlock x:Name="ActionErrorLabel" Foreground="#F0D495" TextWrapping="Wrap" Margin="0,8,0,0"><TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers><Trigger Property="Text" Value=""><Setter Property="Visibility" Value="Collapsed"/></Trigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
      <TextBlock x:Name="MethodLabel" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,14,0,8"/>
      <TextBlock x:Name="UpdateStateLabel" TextWrapping="Wrap" Foreground="#F0D495" Margin="0,0,0,10"/>
      <WrapPanel Margin="0,0,0,12"><Button x:Name="AppFolderButton" Content="Open app folder" Click="AppFolder_Click"/><Button x:Name="DownloadedButton" Content="Show downloaded file" Click="Downloaded_Click"/></WrapPanel>
      <Expander x:Name="VersionSection" Header="Installed version" Foreground="#F1F5FC" Margin="0,10,0,12">
       <StackPanel Margin="0,12,0,0">
        <TextBlock x:Name="LocalLabel" Foreground="#A4B4C9" TextWrapping="Wrap" Margin="0,0,0,12"/>
        <WrapPanel><Button Content="Recheck version" Click="Recheck_Click"/><Button Content="Mark latest as installed" Click="Mark_Click"/></WrapPanel>
        <TextBlock Text="Or enter the installed release tag manually:" Foreground="#A4B4C9" Margin="0,12,0,8"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="InstalledInput" AutomationProperties.Name="Installed version"/><Button Grid.Column="1" Content="Save" Click="SaveVersion_Click" Margin="8,0,0,0"/></Grid>
        <TextBlock Text="Manual marking pauses automatic detection. Resume it in App settings." Foreground="#A4B4C9" Margin="0,10,0,0" TextWrapping="Wrap"/>
       </StackPanel>
      </Expander>
      <Expander Header="Release notes" Foreground="#F1F5FC" Margin="0,0,0,12"><TextBlock x:Name="Notes" TextWrapping="Wrap" Margin="0,12,0,0"/></Expander>
      <TextBlock x:Name="CheckedLabel" Foreground="#A4B4C9" Margin="0,10,0,12"/>
      <WrapPanel><Button x:Name="RecoveryButton" Content="Restore previous files…" Click="Recovery_Click"/><Button x:Name="KeepTrackingButton" Content="Keep tracking" Click="KeepTracking_Click" Visibility="Collapsed" ToolTip="Stop waiting for uninstall completion. This does not cancel a running Windows uninstaller."/><Button x:Name="UninstallButton" Content="Uninstall…" Click="Uninstall_Click"/><Button x:Name="RemoveButton" Content="Stop tracking" Click="Remove_Click" Background="Transparent" Foreground="#F3A6AA"/></WrapPanel>
     </StackPanel>
    </StackPanel></ScrollViewer>
   </Border>
  </Grid>
  <StackPanel Grid.Row="2" Margin="0,16,0,0">
   <ProgressBar x:Name="Progress" Height="4" Minimum="0" Maximum="100" Visibility="Collapsed" Margin="0,0,0,10"/>
   <Button x:Name="CancelDownload" Content="Cancel download" Click="Cancel_Click" Visibility="Collapsed" HorizontalAlignment="Left" Margin="0,0,0,10"/>
   <Grid>
    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
    <TextBlock x:Name="StatusLabel" Foreground="#A4B4C9" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" Margin="0,0,12,0" ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}"/>
    <StackPanel Grid.Column="1" Orientation="Horizontal">
     <TextBlock x:Name="SelfUpdateLabel" VerticalAlignment="Center" Foreground="#A4B4C9" Margin="0,0,6,0"/>
     <Button x:Name="CheckSelfButton" Content="Check GROUT updates" Click="CheckSelf_Click" Margin="0,0,4,0"/>
     <Button x:Name="InstallSelfButton" Content="Update GROUT" Click="InstallSelf_Click" Visibility="Collapsed" Background="#267E70" Margin="0,0,4,0"/>
     <Button x:Name="SettingsButton" Content="Settings" Click="Settings_Click" Margin="0"/>
    </StackPanel>
   </Grid>
  </StackPanel>
 </Grid>
</Window>
